{
  "repo": "__REPO__",
  "base": "__BASE__",
  "concurrency": 3,
  "max_rounds": 3,
  "checks": { "max_runs_per_round": 6 },
  "selfcheck": { "ac_pattern": "AC-\\d+" },
  "auto_merge": true,
  "spec_review": false,
  "notifications": { "enabled": false, "events": [] },
  "language": "es",
  "default_provider": "claude",
  "models": {
    "intake": "fable",
    "spec-writer": { "low": "sonnet", "medium": "opus", "high": "opus" },
    "spec-writer-amend": "sonnet",
    "approver": { "low": "script", "medium": "script", "high": "opus" },
    "approver-llm": { "low": "sonnet", "medium": "sonnet", "high": "opus" }
  },
  "lanes": { "xs": { "reviewers": ["code"], "spec": false, "approver": "script", "max_lines": 80 } },
  "routing": {
    "builder": { "low": "sonnet", "medium": "sonnet", "high": "opus" },
    "reviewers": {
      "code": { "always": true, "model": { "low": "haiku", "medium": "sonnet", "high": "sonnet" } },
      "ux": { "surface": "interaction", "model": "sonnet" },
      "ui": { "surface": "ui", "model": "haiku" },
      "security": { "surface": "security", "model": "opus" }
    }
  },
  "providers": {
    "claude": {
      "models": {
        "intake": "fable",
        "spec-writer": { "low": "sonnet", "medium": "opus", "high": "opus" },
        "spec-writer-amend": "sonnet",
        "approver": { "low": "script", "medium": "script", "high": "opus" },
        "approver-llm": { "low": "sonnet", "medium": "sonnet", "high": "opus" }
      },
      "lanes": { "xs": { "builder": "sonnet", "reviewer": "haiku" } },
      "routing": {
        "builder": { "low": "sonnet", "medium": "sonnet", "high": "opus" },
        "reviewers": {
          "code": { "always": true, "model": { "low": "haiku", "medium": "sonnet", "high": "sonnet" } },
          "ux": { "surface": "interaction", "model": "sonnet" },
          "ui": { "surface": "ui", "model": "haiku" },
          "security": { "surface": "security", "model": "opus" }
        }
      }
    },
    "codex": {
      "prices": {
        "gpt-6-luna": { "input": 0.10, "output": 0.50, "cache_read": 0.01, "cache_write": 0.125 },
        "gpt-6.1-sol": { "input": 2.00, "output": 10.00, "cache_read": 0.10, "cache_write": 2.50 }
      },
      "models": {
        "intake": "gpt-6-luna",
        "spec-writer": { "low": "gpt-6-luna", "medium": "gpt-6-luna", "high": "gpt-6.1-sol" },
        "spec-writer-amend": "gpt-6-luna",
        "approver": { "low": "script", "medium": "script", "high": "gpt-6.1-sol" },
        "approver-llm": { "low": "gpt-6-luna", "medium": "gpt-6-luna", "high": "gpt-6.1-sol" }
      },
      "lanes": { "xs": { "builder": "gpt-6-luna", "reviewer": "gpt-6-luna" } },
      "routing": {
        "builder": { "low": "gpt-6-luna", "medium": "gpt-6-luna", "high": "gpt-6.1-sol" },
        "reviewers": {
          "code": { "always": true, "model": { "low": "gpt-6-luna", "medium": "gpt-6-luna", "high": "gpt-6.1-sol" } },
          "ux": { "surface": "interaction", "model": "gpt-6-luna" },
          "ui": { "surface": "ui", "model": "gpt-6-luna" },
          "security": { "surface": "security", "model": "gpt-6.1-sol" }
        }
      }
    }
  },
  "prices": {
    "fable": { "input": 0, "output": 0, "cache_write": 0, "cache_read": 0 },
    "opus": { "input": 5, "output": 25, "cache_write": 6.25, "cache_read": 0.5 },
    "sonnet": { "input": 3, "output": 15, "cache_write": 3.75, "cache_read": 0.3 },
    "haiku": { "input": 1, "output": 5, "cache_write": 1.25, "cache_read": 0.1 }
  },
  "review_paths": {
    "ui": ["**/*.css", "**/*.html"],
    "ux": ["**/*.css", "**/*.html"]
  },
  "protected_tests": []
}
