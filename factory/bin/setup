#!/bin/sh
# Creates (or updates) every GitHub label the repository uses, from the one list in factory/lib/labels.js:
# the factory's labels and Ask Eminzo's. Safe to run again (--force); run it again after an update.
# Optional arguments limit it to those label names. Every label is tried; each failure is reported and the exit code is 1.
# FACTORY_GH overrides the gh binary (tests use a fake). GH_REPO, when set, makes gh act on that repository.
set -e
GH="${FACTORY_GH:-gh}"
LABELS="$(node "$(dirname "$0")/../lib/labels.js" "$@")"
TAB="$(printf '\t')"
failed=""
while IFS="$TAB" read -r name color description; do
  [ -n "$name" ] || continue
  if ! "$GH" label create "$name" --color "$color" --description "$description" --force; then
    echo "setup: could not create label $name" >&2
    failed="$failed $name"
  fi
done <<EOF_LABELS
$LABELS
EOF_LABELS
if [ -n "$failed" ]; then
  echo "setup: failed labels:$failed" >&2
  exit 1
fi
